---
import { lien } from '../lib/site';
interface Props { titre: string }
const { titre } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre} · Mes fiches IFSI</title>
    <link rel="stylesheet" href={lien('style.css')} />
    <!-- Icône de l'onglet : SVG net à toutes les tailles, PNG pour les navigateurs plus anciens et l'écran d'accueil des téléphones. -->
    <link rel="icon" href={lien('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={lien('favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={lien('apple-touch-icon.png')} />
  </head>
  <body>
    <header>
      <a class="logo" href={lien('')}>Mes fiches IFSI</a>
      <nav>
        <a href={lien('')}>Par semestre</a>
        <a href={lien('organes/')}>Par organe</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      Fiches rédigées par une étudiante. Elles ne sont pas validées par l'IFSI et ne remplacent pas les cours.
    </footer>
  </body>
</html>
