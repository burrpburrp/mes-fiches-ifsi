---
import { lien } from '../lib/site';
export interface Question {
  question: string; choix: string[]; reponses: number[]; explication?: string;
  // Fiche d'origine, affichée dans le QCM général d'une UE.
  fiche?: { id: string; titre: string };
}
interface Props { questions: Question[]; titre?: string; melanger?: boolean }
const { questions = [], titre = 'Teste-toi', melanger = false } = Astro.props;
---
{questions.length > 0 && (
  <section class="qcm" data-melanger={melanger ? '' : undefined}>
    <h2>{titre}</h2>
    {questions.map((q, i) => {
      const plusieurs = q.reponses.length > 1;
      return (
        <fieldset class="question" data-reponses={q.reponses.join(',')}>
          <legend><span class="numero">{i + 1}</span>. {q.question}{plusieurs && <span class="indice"> (plusieurs réponses)</span>}</legend>
          {q.choix.map((choix, j) => (
            <label>
              <input type={plusieurs ? 'checkbox' : 'radio'} name={`q${i}`} value={j} />
              {choix}
            </label>
          ))}
          <p class="correction" hidden>
            <span class="verdict"></span>
            {q.explication && <span> {q.explication}</span>}
            {q.fiche && <span class="origine">Pour réviser : <a href={lien(`fiches/${q.fiche.id}/`)}>{q.fiche.titre}</a></span>}
          </p>
        </fieldset>
      );
    })}
    <button type="button" class="verifier">Vérifier mes réponses</button>
    <p class="score" hidden></p>
  </section>
)}

<script>
  // Correction du QCM directement dans le navigateur : rien n'est enregistré.
  document.querySelectorAll<HTMLElement>('.qcm').forEach((qcm) => {
    // QCM général : nouvel ordre des questions à chaque ouverture de la page.
    if (qcm.hasAttribute('data-melanger')) {
      const questions = [...qcm.querySelectorAll<HTMLElement>('.question')];
      for (let i = questions.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [questions[i], questions[j]] = [questions[j], questions[i]];
      }
      const bouton = qcm.querySelector('.verifier');
      questions.forEach((q, i) => {
        qcm.insertBefore(q, bouton);
        q.querySelector('.numero')!.textContent = String(i + 1);
      });
    }
    qcm.querySelector('.verifier')?.addEventListener('click', () => {
      let bonnes = 0;
      const questions = qcm.querySelectorAll<HTMLElement>('.question');
      questions.forEach((q) => {
        const attendues = (q.dataset.reponses ?? '').split(',').filter(Boolean).map(Number).sort();
        const cochees = [...q.querySelectorAll<HTMLInputElement>('input:checked')].map((c) => Number(c.value)).sort();
        const juste = attendues.length > 0 && attendues.join() === cochees.join();
        if (juste) bonnes++;
        const libelles = [...q.querySelectorAll('label')].map((l) => l.textContent?.trim());
        const correction = q.querySelector<HTMLElement>('.correction')!;
        correction.hidden = false;
        correction.className = `correction ${juste ? 'juste' : 'faux'}`;
        correction.querySelector('.verdict')!.textContent = juste
          ? '✅ Bonne réponse.'
          : `❌ ${attendues.length > 1 ? 'Les bonnes réponses étaient' : 'La bonne réponse était'} : ${attendues.map((a) => libelles[a]).join(' ; ')}.`;
      });
      const score = qcm.querySelector<HTMLElement>('.score')!;
      score.hidden = false;
      score.textContent = `Score : ${bonnes} / ${questions.length}`;
    });
  });
</script>
