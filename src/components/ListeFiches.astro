---
import type { CollectionEntry } from 'astro:content';
import { lien } from '../lib/site';
// Juste le titre de chaque fiche : son type (Pharmacologie…) reste affiché sur la fiche elle-même.
// `qcm` : liens vers les QCM généraux de l'UE, affichés après les fiches.
interface Props { fiches: CollectionEntry<'fiches'>[]; qcm?: { href: string; libelle: string }[] }
const { fiches, qcm = [] } = Astro.props;
---
{fiches.length === 0 ? (
  <p class="vide">Pas encore de fiche ici.</p>
) : (
  <ul class="fiches">
    {fiches.map((f) => (
      <li>
        <a href={lien(`fiches/${f.id}/`)}>{f.data.titre}</a>
      </li>
    ))}
    {qcm.map((q) => (
      <li class="qcm-general"><a href={q.href}>{q.libelle}</a></li>
    ))}
  </ul>
)}
